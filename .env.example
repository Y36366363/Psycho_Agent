# Copy this file to .env and fill in only the provider(s) you use.
# Never commit real API keys.

PSYCHO_MODEL_PROVIDER=openai
PSYCHO_MODEL_REVIEW=true
PSYCHO_REQUEST_TIMEOUT=60

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Generate with: python -m psycho_agent.secure_store generate-key
PSYCHO_AGENT_MASTER_KEY=
# Local web prototype; replace before starting and never commit it.
PSYCHO_AGENT_ADMIN_PASSWORD=
