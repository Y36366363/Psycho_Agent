# Copy this file to .env and fill in only the provider(s) you use.
# Never commit real API keys.

PSYCHO_MODEL_PROVIDER=openai
PSYCHO_MODEL_REVIEW=true
PSYCHO_REQUEST_TIMEOUT=60

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
